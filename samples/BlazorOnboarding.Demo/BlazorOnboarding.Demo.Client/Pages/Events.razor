@page "/events"
@implements IDisposable
@inject IOnboardingService Onboarding

<PageTitle>Events and persistence</PageTitle>

<h1>Events &amp; persistence</h1>

<p class="lede">
    Every moment of a tour is published as an event, including how long each step was on screen.
    Subscribe to <code>IOnboardingService.EventRaised</code> for something quick, or register an
    <code>IOnboardingObserver</code> in DI to forward the stream to your analytics provider.
</p>

<div class="row" style="margin-bottom:1.25rem">
    <button type="button" class="btn btn-primary" @onclick="StartAsync">Run a tour and watch the log</button>
    <button type="button" class="btn" @onclick="Clear">Clear the log</button>
</div>

<AppWindow />

<h2>Live event stream</h2>

@if (_log.Count == 0)
{
    <p class="muted">Nothing yet. Start the tour above.</p>
}
else
{
    <div class="log">
        @foreach (var entry in _log)
        {
            <div class="log-row">
                <span class="log-time">@entry.Time.ToString("HH:mm:ss.fff")</span>
                <span class="log-kind">@entry.Kind</span>
                <span>@entry.Detail</span>
            </div>
        }
    </div>
}

<h2>Persistence</h2>

<p class="muted">
    Progress is written to the registered <code>IOnboardingStore</code> after every step. The default
    store uses <code>localStorage</code> with an in-memory mirror, so reads still work while
    prerendering and in private browsing. Swap it for a server-side store with one call.
</p>

<div class="row" style="margin-bottom:1rem">
    <button type="button" class="btn" @onclick="RefreshRecordAsync">Read the saved record</button>
    <button type="button" class="btn" @onclick="ResetAsync">Forget this tour</button>
    <button type="button" class="btn" @onclick="ResetAllAsync">Forget every tour</button>
</div>

@if (_record is not null)
{
    <table>
        <tbody>
            <tr><th>Tour</th><td>@_record.TourId</td></tr>
            <tr><th>Version</th><td>@_record.Version</td></tr>
            <tr><th>Current step</th><td>@(_record.CurrentStepId ?? "-")</td></tr>
            <tr><th>Completed</th><td>@_record.Completed</td></tr>
            <tr><th>Dismissed</th><td>@_record.Dismissed</td></tr>
            <tr><th>Visited</th><td>@string.Join(", ", _record.VisitedStepIds)</td></tr>
            <tr><th>Updated</th><td>@_record.UpdatedAt.ToLocalTime().ToString("g")</td></tr>
        </tbody>
    </table>
}
else if (_recordChecked)
{
    <p class="muted">No saved record for <code>@TourId</code>.</p>
}

<h2>Wiring it up</h2>

<pre><code>@ObserverExample</code></pre>

<h2>A custom store</h2>

<pre><code>@StoreExample</code></pre>

@code {
    private const string TourId = "analytics";

    private readonly List<LogEntry> _log = [];

    private OnboardingRecord? _record;
    private bool _recordChecked;

    private sealed record LogEntry(DateTime Time, OnboardingEventKind Kind, string Detail);

    protected override void OnInitialized() => Onboarding.EventRaised += OnEvent;

    public void Dispose() => Onboarding.EventRaised -= OnEvent;

    private void OnEvent(object? sender, OnboardingEvent onboardingEvent)
    {
        var detail = onboardingEvent.Step is { } step
            ? $"{step.Id}{(onboardingEvent.Duration is { } duration ? $" after {duration.TotalMilliseconds:0}ms" : string.Empty)}"
            : onboardingEvent.Reason?.ToString() ?? onboardingEvent.Tour.Id;

        _log.Insert(0, new LogEntry(DateTime.Now, onboardingEvent.Kind, detail));

        // Keep the demo log bounded rather than growing without limit.
        if (_log.Count > 60) _log.RemoveRange(60, _log.Count - 60);

        InvokeAsync(StateHasChanged);
    }

    private void Clear()
    {
        _log.Clear();
        _record = null;
        _recordChecked = false;
    }

    private Task StartAsync() => Onboarding.StartAsync(new TourDefinition
    {
        Id = TourId,
        Title = "Analytics demo",
        Steps =
        {
            new StepDefinition
            {
                Id = "create",
                Target = StepTarget.Anchor("new-project"),
                Title = "Step one",
                Description = "Watch the log: a step-shown event fires with the step id.",
                Metadata = new Dictionary<string, object?> { ["funnel"] = "activation" },
            },
            new StepDefinition
            {
                Id = "usage",
                Target = StepTarget.Anchor("usage"),
                Title = "Step two",
                Description = "Leaving a step reports how long it was on screen, which is what funnel analysis needs.",
            },
            new StepDefinition
            {
                Id = "settings",
                Target = StepTarget.Anchor("settings"),
                Title = "Step three",
                Description = "Finish or dismiss the tour and compare the terminal events.",
                DoneLabel = "Finish",
            },
        },
    });

    private async Task RefreshRecordAsync()
    {
        _record = await Onboarding.GetRecordAsync(TourId);
        _recordChecked = true;
    }

    private async Task ResetAsync()
    {
        await Onboarding.ResetAsync(TourId);
        await RefreshRecordAsync();
    }

    private async Task ResetAllAsync()
    {
        await Onboarding.ResetAllAsync();
        await RefreshRecordAsync();
    }

    private const string ObserverExample = """
        public sealed class TourAnalytics(IAnalyticsClient client) : IOnboardingObserver
        {
            public ValueTask OnEventAsync(OnboardingEvent e, CancellationToken ct = default)
            {
                return e.Kind switch
                {
                    OnboardingEventKind.StepShown =>
                        client.TrackAsync("tour_step_shown", new
                        {
                            tour = e.Tour.Id,
                            step = e.Step?.Id,
                            position = e.StepIndex,
                        }),

                    OnboardingEventKind.StepLeft =>
                        client.TrackAsync("tour_step_left", new
                        {
                            step = e.Step?.Id,
                            ms = e.Duration?.TotalMilliseconds,
                        }),

                    OnboardingEventKind.TourCompleted or OnboardingEventKind.TourSkipped =>
                        client.TrackAsync("tour_ended", new { tour = e.Tour.Id, reason = e.Reason }),

                    _ => ValueTask.CompletedTask,
                };
            }
        }

        builder.Services.AddOnboardingObserver<TourAnalytics>();
        """;

    private const string StoreExample = """
        public sealed class ProfileOnboardingStore(IUserProfiles profiles) : IOnboardingStore
        {
            public ValueTask<OnboardingRecord?> GetAsync(string tourId, CancellationToken ct = default)
                => profiles.GetOnboardingAsync(tourId, ct);

            public ValueTask SetAsync(OnboardingRecord record, CancellationToken ct = default)
                => profiles.SaveOnboardingAsync(record, ct);

            public ValueTask RemoveAsync(string tourId, CancellationToken ct = default)
                => profiles.DeleteOnboardingAsync(tourId, ct);

            public ValueTask ClearAsync(CancellationToken ct = default)
                => profiles.DeleteAllOnboardingAsync(ct);
        }

        builder.Services.AddBlazorOnboarding();
        builder.Services.AddOnboardingStore<ProfileOnboardingStore>();
        """;
}
