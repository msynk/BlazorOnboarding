@page "/theming"
@inject IOnboardingService Onboarding

<PageTitle>Theming and RTL</PageTitle>

<h1>Theming &amp; RTL</h1>

<p class="lede">
    Every value in the default look is a CSS custom property under <code>.bo-root</code>. Restyling
    the library is a matter of overriding variables in your own stylesheet, with no selector fights
    and no framework to install.
</p>

<div class="card" style="margin-bottom:1.25rem">
    <div class="row" style="align-items:flex-end">
        <div class="field">
            <label for="theme">Theme</label>
            <select id="theme" @bind="_theme">
                @foreach (var value in Enum.GetValues<OnboardingTheme>())
                {
                    <option value="@value">@value</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="direction">Direction</label>
            <select id="direction" @bind="_direction">
                @foreach (var value in Enum.GetValues<OnboardingDirection>())
                {
                    <option value="@value">@value</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="progress">Progress</label>
            <select id="progress" @bind="_progress">
                @foreach (var value in Enum.GetValues<ProgressStyle>())
                {
                    <option value="@value">@value</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="skin">Skin</label>
            <select id="skin" @bind="_skin">
                <option value="">Default</option>
                <option value="brand-popover">Brand (amber on navy)</option>
            </select>
        </div>

        <button type="button" class="btn btn-primary" @onclick="StartAsync">Run the tour</button>
    </div>
</div>

<AppWindow />

<h2>Localisation</h2>

<p class="muted">
    Button text comes from an <code>OnboardingLabels</code> instance, set globally or per tour. For
    resource files or a translation service, register your own
    <code>IOnboardingLocalizer</code> instead.
</p>

<div class="row" style="margin-bottom:1rem">
    <button type="button" class="btn" @onclick='() => StartLocalizedAsync("en")'>English</button>
    <button type="button" class="btn" @onclick='() => StartLocalizedAsync("de")'>Deutsch</button>
    <button type="button" class="btn" @onclick='() => StartLocalizedAsync("ar")'>العربية (RTL)</button>
</div>

<h2>The variables</h2>

<pre><code>@ThemeExample</code></pre>

<p class="muted">
    Direction affects more than text alignment: in a right-to-left tour the arrow keys swap, and
    <code>Start</code> and <code>End</code> alignments mirror.
</p>

@code {
    private OnboardingTheme _theme = OnboardingTheme.System;
    private OnboardingDirection _direction = OnboardingDirection.Auto;
    private ProgressStyle _progress = ProgressStyle.Dots;
    private string _skin = string.Empty;

    private Task StartAsync() => Onboarding.StartAsync(BuildTour(
        id: "theming",
        labels: null,
        direction: _direction));

    private Task StartLocalizedAsync(string culture)
    {
        var (labels, direction) = culture switch
        {
            "de" => (new OnboardingLabels
            {
                Next = "Weiter",
                Previous = "Zurück",
                Skip = "Überspringen",
                Done = "Fertig",
                Close = "Schließen",
                DialogLabel = "Produktrundgang",
                ProgressFormat = "{0} von {1}",
                StepAnnouncementFormat = "Schritt {0} von {1}. {2}",
                ProgressLabel = "Fortschritt",
                WaitingAnnouncement = "Warten auf den nächsten Teil der Seite.",
            }, OnboardingDirection.LeftToRight),

            "ar" => (new OnboardingLabels
            {
                Next = "التالي",
                Previous = "السابق",
                Skip = "تخطي",
                Done = "إنهاء",
                Close = "إغلاق",
                DialogLabel = "جولة المنتج",
                ProgressFormat = "{0} من {1}",
                StepAnnouncementFormat = "الخطوة {0} من {1}. {2}",
                ProgressLabel = "التقدم",
                WaitingAnnouncement = "في انتظار الجزء التالي من الصفحة.",
            }, OnboardingDirection.RightToLeft),

            _ => (new OnboardingLabels(), OnboardingDirection.LeftToRight),
        };

        return Onboarding.StartAsync(BuildTour($"theming-{culture}", labels, direction));
    }

    private TourDefinition BuildTour(string id, OnboardingLabels? labels, OnboardingDirection direction) => new()
    {
        Id = id,
        Persist = false,
        Theme = _theme,
        Direction = direction,
        Progress = _progress,
        Labels = labels,
        PopoverClass = string.IsNullOrEmpty(_skin) ? null : _skin,
        Steps =
        {
            new StepDefinition
            {
                Id = "create",
                Target = StepTarget.Anchor("new-project"),
                Title = "Create a project",
                Description = "The default look is deliberately quiet, so it sits inside your product rather than on top of it.",
            },
            new StepDefinition
            {
                Id = "usage",
                Target = StepTarget.Anchor("usage"),
                Title = "Usage",
                Description = "Colours, radii, shadows, spacing and motion are all custom properties.",
                Placement = Placement.Bottom,
            },
            new StepDefinition
            {
                Id = "settings",
                Target = StepTarget.Anchor("settings"),
                Title = "Settings",
                Description = "Change the skin above to see a completely different visual identity, with no library changes.",
                Placement = Placement.BottomEnd,
            },
        },
    };

    private const string ThemeExample = """
        /* Your stylesheet, loaded after the library's. */
        .bo-root {
            --bo-accent: #f59e0b;
            --bo-accent-text: #1f1300;
            --bo-surface: #101828;
            --bo-text: #f9fafb;
            --bo-radius: 6px;
            --bo-duration: 160ms;
        }

        /* Or scope it to one tour with PopoverClass. */
        .checkout-tour { --bo-accent: #16a34a; }
        """;
}
