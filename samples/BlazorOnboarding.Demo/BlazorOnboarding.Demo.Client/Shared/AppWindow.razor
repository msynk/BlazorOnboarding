@* A small fake product UI, used as the target surface for the demo tours. Every element that a
   tour points at simply carries a data-bo-anchor attribute; nothing else is needed. *@

<div class="app-window">
    <div class="app-toolbar">
        <button type="button" class="btn btn-primary" data-bo-anchor="new-project">New project</button>
        <button type="button" class="btn" data-bo-anchor="import">Import</button>
        <input type="text" placeholder="Search projects" data-bo-anchor="search" style="min-width:12rem" />
        <span class="spacer" style="margin-inline-start:auto"></span>
        <button type="button" class="btn" data-bo-anchor="settings" @onclick="OnSettingsClick">Settings</button>
        <button type="button" class="btn" data-bo-anchor="account" aria-label="Account">@Initials</button>
    </div>

    <div class="app-body">
        <nav class="app-side" data-bo-anchor="sidebar">
            <span class="sel">Overview</span>
            <span>Projects</span>
            <span>Members</span>
            <span data-bo-anchor="billing">Billing</span>
            <span>Integrations</span>
        </nav>

        <div class="app-main">
            <div class="grid" data-bo-anchor="metrics">
                <div class="tile">
                    <div class="tile-title">Active projects</div>
                    <div class="tile-value">12</div>
                </div>
                <div class="tile" data-bo-anchor="usage">
                    <div class="tile-title">Usage this month</div>
                    <div class="tile-value">68%</div>
                </div>
                <div class="tile">
                    <div class="tile-title">Team members</div>
                    <div class="tile-value">7</div>
                </div>
            </div>

            @ChildContent
        </div>
    </div>
</div>

@code {
    /// <summary>Extra content rendered inside the fake application body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Initials shown on the account button.</summary>
    [Parameter] public string Initials { get; set; } = "AM";

    /// <summary>Raised when the settings button is pressed.</summary>
    [Parameter] public EventCallback OnSettingsClick { get; set; }
}
